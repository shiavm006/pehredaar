# Copy to .env and fill in. DRY_RUN=true never places a real phone call.

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=frigate/reviews

FRIGATE_BASE_URL=http://localhost:5001

# Vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional second Gemini model after primary (+1 transient retry) fails.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GROQ_API_KEY=
# Optional Groq vision fallback. Empty = skip Groq and use fail-safe.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Bolna outbound call
BOLNA_API_KEY=
BOLNA_AGENT_ID=
OWNER_PHONE=
SHOP_NAME=Pehredaar Demo Shop

# Safety: print payload instead of calling Bolna
DRY_RUN=true

# Armed schedule. ARMED=true forces on; ARMED=false forces off.
# ARMED_HOURS like 21:00-07:00 (crosses midnight) when ARMED is unset/empty.
ARMED=true
ARMED_HOURS=

# Per-camera cooldown between owner calls (seconds).
# Default in code is 180; use 30 when running scripts/run_video_tests.sh.
COOLDOWN_SECONDS=30

# Frigate internal RTSP restream credential (loopback / compose network only).
FRIGATE_RTSP_PASSWORD=
